# Auto detect text files and perform LF normalization on checkout/checkin
* text=auto eol=lf

# Source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
